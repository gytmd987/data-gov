# ── 생성 LLM (이미 vLLM으로 기동 중; 이 스택에 포함하지 않음) ──────────────
# 현재 Qwen3.6-27B가 ~83GB 점유. 여유 확보하려면 vLLM을 재튜닝 권고(docs/vram.md):
#   --gpu-memory-utilization 0.48 --quantization fp8 --max-model-len 16384 --max-num-seqs 16
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=Qwen/Qwen3.6-27B

# ── 임베딩 / 리랭커 (TEI, docker-compose) ─────────────────────────────────
# 잔여 VRAM이 좁으므로(~13GB) 작은 BGE 계열을 기본값으로 채택. 여유가 생기면 Qwen3-Embedding 등으로 교체.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_PORT=8081
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_PORT=8082

# ── 파싱 / OCR ────────────────────────────────────────────────────────────
# 기본: Granite-Docling(258M) + PaddleOCR(한국어). 무거운 Qwen3-VL은 vLLM 재튜닝 후 선택 도입.
PARSER_VLM=ibm-granite/granite-docling-258M
PARSER_DEVICE=cuda            # 잔여 VRAM 부족 시 cpu 로 폴백
PADDLEOCR_LANG=korean

# ── 폐쇄망 배포 ────────────────────────────────────────────────────────────
# 외부 egress 차단 환경에서는 1로 두고 모델 가중치를 사전 다운로드해 hf_cache 볼륨에 배치.
HF_HUB_OFFLINE=0

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=ragadmin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ragdb
POSTGRES_PORT=5432

# ── Qdrant ─────────────────────────────────────────────────────────────────
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ── MinIO (원본 파일 저장소) ───────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── 검색 파라미터 ──────────────────────────────────────────────────────────
HYBRID_TOP_N=40               # 하이브리드 검색 후보 수 (리랭킹 입력)
RERANK_TOP_K=6                # 리랭킹 후 최종 컨텍스트 청크 수
