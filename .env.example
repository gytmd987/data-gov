# ── 생성 LLM (이미 vLLM으로 기동 중; 이 스택에 포함하지 않음) ──────────────
# 현재 Qwen3.6-27B가 ~83GB 점유. 여유 확보하려면 vLLM을 재튜닝 권고(docs/vram.md):
#   --gpu-memory-utilization 0.48 --quantization fp8 --max-model-len 16384 --max-num-seqs 16
VLLM_BASE_URL=http://localhost:8000/v1      # 끝에 /v1 포함. VLLM_MODEL은 /v1/models 의 id와 일치해야 함
VLLM_API_KEY=EMPTY
VLLM_MODEL=thinkingcap
# 적재 자동채움의 구조화 출력 방식 (vLLM 버전에 맞춰 선택):
#   guided_json(기본) | response_format(최신 vLLM 권장) | json_object(강제 약함)
# guided_json에서 400이 나면 response_format 로 바꾸거나, VLLM_GUIDED_BACKEND=xgrammar 를 시도.
VLLM_STRUCTURED_MODE=guided_json
VLLM_GUIDED_BACKEND=

# ── 응답 속도 ────────────────────────────────────────────────────────────────
# 생성 토큰 수 = 대기 시간. 상한이 없으면 모델이 늘어놓는 만큼 사용자가 기다린다.
# ⚠️ 추론 모델(Qwen3 계열 등)은 **추론 토큰도 이 한도를 함께 쓴다.** 빠듯하게 잡으면
# 생각만 하다 끝나 본문이 비어서 오고(finish_reason=length), 업로드가 통째로 실패한다.
# 상한일 뿐이라 모델이 일찍 멈추면 남는 만큼은 비용이 없으니 넉넉히 잡을 것.
# (모자라면 클라이언트가 한도를 두 배로 늘려 다시 시도한다 — 최대 8000)
VLLM_MAX_TOKENS=1500         # 채팅 답변 상한
VLLM_TASK_MAX_TOKENS=2000    # 도구 선택·SQL 등 구조화 응답 상한
# 추론(<think>). Qwen3 계열은 기본이 '켜짐'이라 짧은 질문에도 수백~수천 토큰을 먼저
# 만든다. 그 토큰은 화면에 안 보이므로 사용자에겐 그냥 멈춰 있는 시간이다.
#   off    : 항상 끔 — 제일 빠름(품질이 견딜 만하면 권장)
#   answer : 답변에만 허용, 도구 선택·SQL 은 끔 (기본)
#   on     : 항상 켬(예전 동작)
# 느리면 `python -m scripts.bench_chat "질문" --user 내이메일` 로 먼저 재 볼 것.
# (off/on 을 바꿔도 차이가 없으면 이 모델은 추론을 안 쓰는 것이니 신경 쓰지 말 것)
VLLM_THINKING=answer

# ── 모델에 보내는 글자 수 ────────────────────────────────────────────────────
# 표(엑셀·워드 표)는 헤더를 지키려고 쪼개지 않고 한 청크로 둔다 → 청크 하나가 수만 자가
# 되기도 한다. 그 전문을 리랭커·답변 프롬프트에 그대로 넣으면 둘 다 그만큼 느려진다.
# 판단에는 앞부분이면 충분하므로 **보낼 때만** 자른다(저장된 원문·인용·다운로드는 그대로).
RERANK_TOP_N=24         # 리랭커에 넘길 후보 수. 크로스 인코더라 후보 수에 비례해 느려진다
RERANK_MAX_CHARS=1200   # 리랭커에 보낼 청크당 글자 수
# 리랭커가 **CPU 로 돌면** 후보 24개에 8초쯤 걸린다(고장이 아니라 원래 무거운 작업 —
# 임베딩은 질문 한 줄만, 리랭커는 문서 24개 전문을 처리한다. 약 1,000배).
# GPU 를 못 쓰면 끄기 전에 먼저 줄여 보라: RERANK_TOP_N=8 · RERANK_MAX_CHARS=600 → 약 1초.
# 그래도 느리면 끈다. 검색 융합(의미+BM25) 순위를 그대로 쓴다 — 정확도는 조금 떨어진다.
#   python -m scripts.check_tei   로 GPU 로 도는지 재 볼 것.
RERANK_ENABLED=true
ANSWER_MAX_CHARS=2500   # 답변 프롬프트에 넣을 청크당 글자 수
# 프롬프트 전체 상한. vLLM 의 --max-model-len 을 넘으면 요청이 거절돼 답이 안 나온다.
# 한국어는 대략 2자 ≈ 1토큰 → 20,000자 ≈ 10,000토큰(--max-model-len 16384 안에 여유).
ANSWER_TOTAL_CHARS=20000

# ── 임베딩 / 리랭커 (TEI, docker-compose) ─────────────────────────────────
# 임베딩: 한국어 위주이므로 한국어 특화 KURE-v1(고려대, BGE-M3 기반, 568M ~2GB)을 기본값으로.
#   대안(골드셋 A/B): BAAI/bge-m3(다국어·sparse 내장), nlpai-lab/KoE5, dragonkue/BGE-m3-ko
#   하이브리드의 sparse(어휘) 축은 KURE가 dense 중심이므로 Qdrant 내장 BM25로 처리(모델 추가 불필요).
EMBEDDING_MODEL=nlpai-lab/KURE-v1
EMBEDDING_PORT=8081
EMBEDDING_DIM=1024            # KURE-v1(BGE-M3 계열) dense 차원. 프리플라이트가 실제 차원을 알려줌
# TEI 도커 이미지 태그. 블랙웰(SM120)이면 :latest 가 안 될 수 있으니 최신 버전 태그로 지정.
#   GPU 예: TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:1.8   (릴리스 확인 후 최신으로)
#   CPU 예: TEI_IMAGE_CPU=ghcr.io/huggingface/text-embeddings-inference:cpu-1.8
# 최신 태그도 안 되면 blackwell dockerfile로 직접 빌드(아래 docs/smoke_test.md 참고).
TEI_IMAGE=
TEI_IMAGE_CPU=
# 리랭커: bge-reranker-v2-m3가 2026 기본값(Apache 2.0·한국어 최적화). Korean 파인튜닝 변형 A/B 권장.
#   대안: dragonkue/bge-reranker-v2-m3-ko(한국어 특화). ⚠️ jina-reranker-v3는 CC-BY-NC(상업 금지)로 배제.
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_PORT=8082

# ── 파싱 / OCR ────────────────────────────────────────────────────────────
# 스캔·이미지 OCR 백엔드:
#   vllm         (기본) 이미 서빙 중인 Qwen3.6-27B 멀티모달 재사용 → 추가 모델·VRAM 0
#   none         OCR 비활성(텍스트 레이어 있는 문서만 처리)
#   paddleocr-vl 전용 파서(표 많은 스캔본·대량 처리로 정확도/처리량 필요 시 — 별도 배포)
# 인사 문서 대부분은 디지털(docx/pptx/xlsx/텍스트 PDF)이라 이미지 OCR은 소수 경로 → 기본 vllm 재사용이 합리적.
OCR_BACKEND=vllm
PARSER_MODEL=PaddleOCR-VL      # OCR_BACKEND=paddleocr-vl 일 때만 사용
PARSER_DEVICE=cuda
PARSER_LANG=korean

# ── 폐쇄망 배포 (HuggingFace 접속 차단 시) ─────────────────────────────────
# 1) 인터넷 머신에서: bash scripts/download_models.sh  → ./models 생성 후 서버로 전송
# 2) 아래를 로컬 경로로 지정하고 HF_HUB_OFFLINE=1. 자세히: docs/offline_models.md
#   EMBEDDING_MODEL=/models/KURE-v1
#   RERANKER_MODEL=/models/bge-reranker-v2-m3
HF_HUB_OFFLINE=0

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=ragadmin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ragdb
POSTGRES_PORT=5432

# ── Qdrant ─────────────────────────────────────────────────────────────────
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ── MinIO (원본 파일 저장소) ───────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── 검색 파라미터 ──────────────────────────────────────────────────────────
HYBRID_TOP_N=40               # 하이브리드 검색 후보 수 (리랭킹 입력)
RERANK_TOP_K=6                # 리랭킹 후 최종 컨텍스트 청크 수

# ── 예약 업로드(웹에서 올려두고 야간에 자동 등록) ──────────────────────────
UPLOAD_QUEUE_DIR=./storage/_queue   # 예약된 파일이 처리 전까지 머무는 곳
INGEST_WINDOW_START=18:00           # 처리 시작(업무시간 GPU 점유를 피함)
INGEST_WINDOW_END=08:00             # 처리 종료. 시작>종료면 자정을 넘김
# 동시 처리 수. 4~8 은 **임베딩이 GPU 에 있을 때** 기준이다.
# 임베딩이 CPU 로 돌고 있으면 문서 4건을 동시에 임베딩해 코어를 전부 먹는다 → 1 로.
INGEST_WORKERS=4
UPLOAD_BATCH_FILES=20               # 브라우저가 한 번에 보내는 파일 수(나눠 보내기)
UPLOAD_BATCH_MB=50                  # 한 묶음 최대 크기(둘 중 먼저 걸리는 쪽)
UPLOAD_MAX_TOTAL_MB=2048            # 한 번에 예약할 수 있는 총 용량
SCHEDULE_TIMEZONE=Asia/Seoul        # 예약 시각 해석 기준(서버 시계가 UTC 여도 이 기준)
