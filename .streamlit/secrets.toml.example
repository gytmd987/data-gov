# 사내 SSO(OIDC) 로그인 설정 예시.
# 이 파일을 .streamlit/secrets.toml 로 복사하고 값을 채우세요(실제 파일은 git에 올리지 마세요).
# 값은 IT/보안팀(SSO 관리자)에게 요청합니다. 자세히: docs/인증_SSO.md

[auth]
# 로그인 후 돌아올 주소. Streamlit 접속 주소 + /oauth2callback
redirect_uri = "http://localhost:8501/oauth2callback"
# 세션 쿠키 암호화용 임의의 긴 랜덤 문자열(직접 생성): python -c "import secrets;print(secrets.token_hex(32))"
cookie_secret = "여기에-임의의-랜덤-문자열"
# SSO에서 이 앱을 등록하고 발급받는 값
client_id = "SSO에서-발급한-client-id"
client_secret = "SSO에서-발급한-client-secret"
# SSO의 OIDC 디스커버리 주소 (대부분 아래 형태)
server_metadata_url = "https://sso.company.com/.well-known/openid-configuration"
